# Gold Session Lab Pro — Environment Configuration Example
# برنامه منحصراً در محیط محلی (Localhost) اجرا می‌شود و به هیچ کلید معاملاتی زنده نیاز ندارد.

APP_NAME="Gold Session Lab Pro"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000

# SQLite Local Database
DATABASE_URL="sqlite:///data/xauusd_lab.sqlite"

# Paper Broker Settings
VIRTUAL_INITIAL_BALANCE=10000.0
DEFAULT_LEVERAGE=100.0
COMMISSION_PER_LOT=5.0
SLIPPAGE_PIPS=0.10

# Bot Risk Controls
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=4

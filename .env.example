# Gold Session Lab Pro — Environment Configuration Example
# برنامه منحصراً در محیط محلی (Localhost) اجرا می‌شود و به هیچ کلید معاملاتی زنده نیاز ندارد.

APP_NAME="Gold Session Lab Pro"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000

# SQLite Local Database
DATABASE_URL="sqlite:///data/xauusd_lab.sqlite"

# Paper Broker Settings
VIRTUAL_INITIAL_BALANCE=10000.0
DEFAULT_LEVERAGE=100.0
COMMISSION_PER_LOT=5.0
SLIPPAGE_PIPS=0.10

# Bot Risk Controls
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=4

# Read-only OANDA prices (optional; XAU_USD availability varies by account/region)
# DO NOT commit an actual token. No order API is used.
OANDA_ENV=practice
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=

# OFF by default. To inspect the bundled synthetic dataset in replay,
# explicitly enable this; demo bars NEVER authorize paper trades.
GOLDLAB_ENABLE_DEMO_REPLAY=0

# Live XAU/USD Bid/Ask comes from OANDA account pricing stream, read-only.
# Candles come independently from OANDA completed M1 midpoint candles.
# A credential alone is not enough: XAU_USD must be enabled for the account.
# No live trading/order placement is supported.

# Evidence collection loop; NOT an Antigravity AI task scheduler
AGENT_OBSERVE_INTERVAL_SECONDS=300
